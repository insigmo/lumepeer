{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumepeer",
  "version": "0.1.0",
  "identifier": "io.insigmo.lumepeer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumepeer",
        "width": 960,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFM0Y1N0JFNzZBNTI3OTAKUldTUUo2VjJ2bGMvUHEreURxUnhQcDEwdXZYTXBvSkdwUnI4ZzBvd3NpVEFIZVdYN1NCVk5sWU8K",
      "endpoints": []
    }
  }
}
