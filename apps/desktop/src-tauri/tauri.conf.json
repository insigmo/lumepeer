{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumepeer",
  "version": "0.0.36",
  "identifier": "io.insigmo.lumepeer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "npm run glibc-floor"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumepeer",
        "width": 960,
        "height": 640,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/lumepeer-decoder-worker",
      "binaries/lumepeer-service"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libpipewire-0.3-0"],
        "recommends": ["xdg-desktop-portal", "pipewire"]
      },
      "rpm": {
        "depends": ["pipewire-libs"],
        "recommends": ["xdg-desktop-portal", "pipewire"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFM0Y1N0JFNzZBNTI3OTAKUldTUUo2VjJ2bGMvUHEreURxUnhQcDEwdXZYTXBvSkdwUnI4ZzBvd3NpVEFIZVdYN1NCVk5sWU8K",
      "endpoints": []
    }
  }
}
