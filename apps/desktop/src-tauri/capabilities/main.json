{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Per-window capability of the main window. Design doc §13: no filesystem, shell, network or arbitrary command permissions, and no wildcard entries. Every application command it may call is named here one by one; a command that is not listed cannot be invoked from this window at all.",
  "windows": ["main"],
  "local": true,
  "remote": {
    "urls": ["http://localhost:*", "http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    {
      "identifier": "core:window:allow-close",
      "allow": [{ "label": "main" }]
    },
    {
      "identifier": "core:window:allow-minimize",
      "allow": [{ "label": "main" }]
    },
    {
      "identifier": "core:window:allow-toggle-maximize",
      "allow": [{ "label": "main" }]
    },
    {
      "identifier": "core:window:allow-start-dragging",
      "allow": [{ "label": "main" }]
    },
    "updater:default",
    "allow-session-grant",
    "allow-session-revoke",
    "allow-session-status",
    "allow-session-set-grant",
    "allow-address-book-list",
    "allow-address-book-upsert",
    "allow-address-book-remove",
    "allow-address-book-set-trusted",
    "allow-unattended-status",
    "allow-unattended-set-password",
    "allow-unattended-disable",
    "allow-unattended-set-totp",
    "allow-unattended-set-role",
    "allow-unattended-submit",
    "allow-connection-history",
    "allow-history-connect",
    "allow-history-remove",
    "allow-connect-status",
    "allow-connect-cancel",
    "allow-network-status",
    "allow-connection-stats",
    "allow-license-status",
    "allow-invite-create",
    "allow-invite-connect",
    "allow-chat-send",
    "allow-chat-transcript",
    "allow-clipboard-push",
    "allow-clipboard-pull",
    "allow-file-accept",
    "allow-file-abort",
    "allow-file-transfers",
    "allow-audio-toggle",
    "allow-recording-toggle",
    "allow-recordings-list",
    "allow-recording-export",
    "allow-audit-list",
    "allow-audit-kinds",
    "allow-audit-status",
    "allow-audit-export",
    "allow-audit-clear",
    "allow-update-check",
    "allow-update-install",
    "allow-autostart-status",
    "allow-autostart-set",
    "allow-service-status",
    "allow-service-set"
  ]
}
